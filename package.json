{
  "name": "nib",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Turn typed text into realistic handwritten pages.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc -b",
    "smoke": "npm run test:browser && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "5.3.0",
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-blockquote": "3.33.0",
    "@tiptap/extension-highlight": "3.33.0",
    "@tiptap/extension-list": "3.33.0",
    "@tiptap/extensions": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/react": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "@tiptap/suggestion": "3.33.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "idb": "8.0.4",
    "jspdf": "2.5.1",
    "lucide-react": "1.70.0",
    "mammoth": "1.8.0",
    "opentype.js": "1.3.4",
    "pdfjs-dist": "3.11.174",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "vaul": "1.1.2",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
